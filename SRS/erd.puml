@startuml erd
' Nguồn: SRS mục 5.2 - Mô hình dữ liệu (ERD)
' Lưu file ở dạng UTF-8. Chạy dòng lệnh: plantuml -charset UTF-8 erd.puml
hide circle
skinparam linetype ortho
skinparam shadowing false

entity "ROOMS" as ROOMS {
  * roomid : int <<PK>>
  --
  room_name : string
  type : string
  accessible : boolean
  image : string
  description : string
  features : array
  roomPrice : int
}

entity "BOOKINGS" as BOOKINGS {
  * bookingid : int <<PK>>
  --
  roomid : int
  firstname : string
  lastname : string
  depositpaid : boolean
  checkin : date
  checkout : date
}

entity "MESSAGES" as MESSAGES {
  * messageid : int <<PK>>
  --
  name : string
  email : string
  phone : string
  subject : string
  description : string
  read : boolean
}

entity "ACCOUNTS" as ACCOUNTS {
  username : string
  password : string
}

entity "TOKENS" as TOKENS {
  token : string
  expiry : date
}

entity "BRANDINGS" as BRANDINGS {
  * brandingid : int <<PK>>
  --
  name : string
  logo_url : string
  description : string
  directions : string
  latitude : double
  longitude : double
  contact_name : string
  phone : string
  email : string
  line1 : string
  line2 : string
  post_town : string
  county : string
  post_code : string
}

' Tham chiếu logic qua roomid, không có khóa ngoại (đường nét đứt)
ROOMS ||..o{ BOOKINGS : "roomid (tham chiếu logic)"

note bottom of BOOKINGS
  email và phone của booking chỉ có trong yêu cầu đặt phòng,
  không lưu trong bảng BOOKINGS; chúng được dùng để tạo
  tin nhắn thông báo.
end note

note as N1
  Mỗi dịch vụ có CSDL riêng.
  Quan hệ ROOMS - BOOKINGS là tham chiếu logic
  qua roomid, không có khóa ngoại.
end note
@enduml
